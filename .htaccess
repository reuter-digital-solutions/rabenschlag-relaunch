# Elektrotechnik Rabenschlag – Relaunch 2026
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /fehler.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Interne Ordner sperren
  RewriteRule ^(inc|_dev-mails)(/|$) - [F,L]
  RewriteRule ^_router\.php$ - [F,L]
  # /seite.php -> /seite (301)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ /%1 [R=301,L]
  # /seite -> seite.php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Upload-Grenzen für Bewerbungen (falls der Hoster php_value erlaubt)
<IfModule mod_php.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 20M
  php_value max_file_uploads 8
</IfModule>
